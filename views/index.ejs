<% layout("layouts/boilerplate.ejs") %>
<body>
  <!-- Hero Section -->
  <section class="hero-section text-center">
    <h1>Swap Skills, Learn & Teach for Free!</h1>
    <p>Exchange your expertise with others. No money involved — just knowledge sharing and community building.</p>

    <div class="search-bar input-group mx-auto">
      <input type="text" class="form-control" placeholder="Search skills e.g. Graphic Design, Piano, Coding...">
      <button class="btn btn-gradient">Find Skills</button>
    </div>

    <div class="popular-skills mt-4">
      <button class="btn btn-outline-primary">Web Development</button>
      <button class="btn btn-outline-primary">Digital Photography</button>
      <button class="btn btn-outline-primary">Graphic Design</button>
      <button class="btn btn-outline-primary">Data Analysis</button>
      <button class="btn btn-outline-primary">Language Learning</button>
      <button class="btn btn-outline-primary">Music Production</button>
    </div>
  </section>

  <!-- Featured Skill Swappers -->
  <section class="featured-section container mt-5">
    <h3 class="text-center mb-4">Featured Skill Swappers</h3>
    <div class="row justify-content-center">
      <div class="col-md-4 mb-4">
        <div class="card p-3 text-center">
          <h5 class="card-title">Sarah Chen</h5>
          <p>Can teach: <span class="badge bg-primary">Web Development</span> <span class="badge bg-primary">Digital Photography</span></p>
          <p>Looking to learn: <span class="badge bg-success">Graphic Design</span></p>
          <button class="btn btn-gradient">Request Swap</button>
        </div>
      </div>
      <div class="col-md-4 mb-4">
        <div class="card p-3 text-center">
          <h5 class="card-title">Alex Rodriguez</h5>
          <p>Can teach: <span class="badge bg-primary">Data Analysis</span> <span class="badge bg-primary">Python</span></p>
          <p>Looking to learn: <span class="badge bg-success">UI/UX Design</span></p>
          <button class="btn btn-gradient">Request Swap</button>
        </div>
      </div>
      <div class="col-md-4 mb-4">
        <div class="card p-3 text-center">
          <h5 class="card-title">Emma Thompson</h5>
          <p>Can teach: <span class="badge bg-primary">Creative Writing</span> <span class="badge bg-primary">Mastering</span></p>
          <p>Looking to learn: <span class="badge bg-success">Web Development</span></p>
          <button class="btn btn-gradient">Request Swap</button>
        </div>
      </div>
    </div>
  </section>
</body>
