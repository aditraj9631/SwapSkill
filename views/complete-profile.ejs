<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Swap Skills</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="complete-profile-style.css">
</head>
<body>
<div class="skill-page">
    <div class="container py-5">

        <div class="row justify-content-center">
            <div class="col-lg-7 col-md-9">

                <div class="skill-card">

                    <!-- Header -->
                    <div class="skill-header text-center">
                        <div class="skill-icon">
                            <i class="bi bi-lightbulb"></i>
                        </div>

                        <h2>Add Your Skill</h2>
                        <p>
                            Tell us about a skill you want to teach or learn.
                        </p>
                    </div>

                    <!-- Error Message -->
                    <% if (typeof error !== "undefined" && error) { %>
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-circle me-2"></i>
                            <%= error %>
                        </div>
                    <% } %>

                    <!-- Success Message -->
                    <% if (typeof success !== "undefined" && success) { %>
                        <div class="alert alert-success">
                            <i class="bi bi-check-circle me-2"></i>
                            <%= success %>
                        </div>
                    <% } %>

                    <form action="/complete-profile" method="POST" id="skillForm">

                        <!-- Skill ID -->
                        <div class="mb-4 ">
                            <label for="skill_name" class="form-label">
                                Skill I want to learn
                            </label>
                            <select class="form-select"
                                id="learnSkills"
                                name="learnSkills[]"
                                multiple
                                size="1">
                                <!-- <option value="Full Stack Web Devlopment">Full Stack Web Devlopment</option>
                                <option value="Front End Web Devlopment">Front End Web Devlopment</option>
                                <option value="Python">Python</option>
                                <option value="C Programming">C Programming</option>
                                <option value="C++">C++</option>
                                <option value="Java Programming">Java Programming</option>
                                <option value="SpringBoot">SpringBoot</option>
                                <option value="Backend web Devlopment">Backend web Devlopment</option>
                                <option value="Graphics Design">Graphics Design</option>
                                <option value="Machine Learning">Machine Learning</option>
                                <option value="Prompt Engineering">Prompt Engineering</option>
                                <option value="Cyber Security">Cyber Security</option> -->

                                <% skills.forEach(skill => { %>

                                    <option value="<%= skill.skill_id %>">
                                    <%= skill.skill_name %>
                                </option>

        <% }) %>
                                
                            </select>
                        <div class="mb-4 ">
                            <label for="skill_name" class="form-label">
                                Skill I want to teach
                            </label>
                            <select class="form-select"
                                id="teachSkills"
                                name="teachSkills[]"
                                multiple
                                size="1">
                                <% skills.forEach(skill => { %>

                                <option value="<%= skill.skill_id %>">
                                               <%= skill.skill_name %>
                                </option>

                            <% }) %>

                            </select>

                            <div class="form-text">
                                Enter skill you want to learn or teach.
                            </div>
                        </div>


                        <!-- Level -->
                        <div class="mb-4">
                            <label for="level" class="form-label">
                                Skill Level
                            </label>

                            <select
                                class="form-select"
                                id="level"
                                name="level"
                                required
                            >
                                <option value="" selected disabled>
                                    Select your skill level
                                </option>

                                <option value="Beginner">
                                    Beginner
                                </option>

                                <option value="Intermediate">
                                    Intermediate
                                </option>

                                <option value="Advanced">
                                    Advanced
                                </option>
                            </select>
                        </div>

                        <!-- Experience -->
                        <div class="mb-4">
                            <label for="experience" class="form-label">
                                Experience
                            </label>

                            <div class="input-group">
                                <input
                                    type="number"
                                    class="form-control"
                                    id="experience"
                                    name="experience"
                                    min="0"
                                    max="100"
                                    placeholder="Enter years of experience"
                                    required
                                >

                                <span class="input-group-text">
                                    Years
                                </span>
                            </div>

                            <div class="form-text">
                                Enter your experience in years.
                            </div>
                        </div>

                        <!-- Buttons -->
                        <div class="skill-form-buttons">

                            <a
                                href="/dashboard"
                                class="btn btn-outline-light"
                            >
                                <i class="bi bi-arrow-left me-2"></i>
                                Cancel
                            </a>

                            <button
                                type="submit"
                                class="btn btn-outline-light"
                                id="submitSkillBtn"
                            >
                                <i class="bi bi-plus-circle me-2"></i>
                                Add Skill
                            </button>

                        </div>

                    </form>

                </div>

            </div>
        </div>

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
<script src="complete-profile-script.js"></script>
</body>
</html>